# Paste into Dokploy -> your Compose app -> Environment, then replace every
# "replace-with-..." value. Never commit the real values. See docs/DEPLOYMENT.md.
#
# ENVIRONMENT, ROOT_PATH and DATABASE_URL are set by docker-compose.dokploy.yml.
# In production the API refuses to start with a placeholder SECRET_KEY or
# ALLOWED_HOSTS=*, and the admin seed refuses the example password.

# --- Application ---------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Public host(s) the API answers to, comma-separated, no scheme.
ALLOWED_HOSTS=task-mgmt.ankit-poudel.com.np
# The dashboard is served from the same origin, so CORS stays off.
CORS_ORIGINS=
# Swagger UI at /docs and ReDoc at /redoc (set false to hide them).
DOCS_ENABLED=true
# Uvicorn worker processes for the API.
WEB_CONCURRENCY=2

# --- Database (PostgreSQL container in the same stack) ----------------------
POSTGRES_USER=task_user
# Letters, digits, - and _ only: the password is embedded in the database URL.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=task_db
# PostgreSQL keeps the password from the deploy that first created its volume.
# Got "password authentication failed" after changing POSTGRES_PASSWORD and
# there's no real data yet? Raise this by one to start a fresh, empty database.
# Never raise it once the app holds real data.
# DB_VOLUME_VERSION=1

# --- First admin (created on deploy if the account doesn't exist yet) -------
FIRST_ADMIN_EMAIL=replace-with-your-email@example.com
# At least 8 characters with a letter and a digit.
FIRST_ADMIN_PASSWORD=replace-with-a-strong-password-1
