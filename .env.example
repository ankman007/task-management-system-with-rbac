# --- Application ---------------------------------------------------------
ENVIRONMENT=local
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Comma-separated origins allowed by CORS (empty = CORS disabled)
CORS_ORIGINS=

# --- Database ------------------------------------------------------------
POSTGRES_USER=task_user
POSTGRES_PASSWORD=task_password
POSTGRES_DB=task_db
# Inside docker compose the host is "db"; locally use localhost:${DB_HOST_PORT}
DATABASE_URL=postgresql+asyncpg://task_user:task_password@localhost:15432/task_db

# --- First admin (used by scripts/seed_admin.py) ---------------------------
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=Admin12345

# --- Host ports (container ports stay 8000 / 5432 / 80) --------------------
API_HOST_PORT=18000
DB_HOST_PORT=15432
FRONTEND_HOST_PORT=18080
